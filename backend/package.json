{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run src/main/server.ts",
    "start": "bun run src/main/server.ts",
    "test": "bun test ../testes/backend/",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:reset": "bun run src/infra/database/scripts/reset-db.ts && bun run db:migrate",
    "db:reset:full": "bun run src/infra/database/scripts/reset-db.ts && bun run db:migrate && bun run db:seed:genres",
    "db:seed:genres": "bun run src/infra/database/scripts/seed-genres.ts",
    "db:import:movies": "bun run src/infra/database/scripts/import-movies.ts",
    "posters:fill": "bun run src/infra/database/scripts/fill-movie-posters.ts",
    "db:translate-csv": "bun run src/infra/database/scripts/translate-movies-csv.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "axios": "^1.17.0",
    "better-auth": "^1.6.18",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
